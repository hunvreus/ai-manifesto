{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-manifesto",
  "compatibility_date": "2026-05-26",
  "workers_dev": true,
  "route": {
    "pattern": "ronanberder.com/ai-manifesto*",
    "zone_name": "ronanberder.com"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
