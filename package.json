{
  "name": "ai-augmented-development-manifesto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve --quiet",
    "worker:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "wrangler": "^4.94.0"
  }
}
